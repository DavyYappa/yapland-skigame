{% extends 'base.html.twig' %}

{% block title %}Mail{% endblock %}

{% block body %}
<div class="page-head">
    <div>
        <h1>Uitnodigingsmail</h1>
        <p class="muted">Deze mail krijgt elke uitnodiging, met een eigen claimlink en afmeldlink.</p>
    </div>
    <form method="post" action="{{ path('admin_mailing_test') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('mailing_test') }}">
        <button class="btn ghost">Stuur mij een testmail</button>
    </form>
</div>

<div class="grid">
    <section class="card">
        <h2>Tekst</h2>
        {{ form_start(form, {attr: {class: 'stack'}}) }}
            {{ form_row(form.subject) }}
            {{ form_row(form.body) }}
            {{ form_row(form.buttonLabel) }}
            <div><button class="btn">Opslaan</button></div>
        {{ form_end(form) }}
    </section>

    <section class="card">
        <h2>Voorbeeld</h2>
        <p class="muted">Met "Voorbeeld bv" als bedrijf. De vaste stukken (claimdatum, afmeldlink) staan er altijd in.</p>
        <iframe class="mail-preview" title="Voorbeeld van de mail" sandbox srcdoc="{{ preview|e('html_attr') }}"></iframe>
    </section>
</div>
{% endblock %}
